+#include <android-base/properties.h>
 #include <android-base/stringprintf.h>
+#include <binder/IServiceManager.h>
+#include <binder/Parcel.h>
+#include <cinttypes>
 #include <common/trace.h>
 #include <compositionengine/CompositionEngine.h>
 #include <compositionengine/CompositionRefreshArgs.h>
@@ -44,6 +48,38 @@ using aidl::android::hardware::graphics::composer3::DisplayCapability;
 
 namespace android::compositionengine::impl {
 
+namespace {
+
+// Qualcomm's display engine can draw the rounded screen corners itself (the DSPP RC block),
+// leaving the source pipes to real layers, but only for layers marked through the vendor
+// DisplayConfig service; CLO SurfaceFlinger does that, AOSP doesn't. With 3 pipes (SM7435), the
+// two corner overlays otherwise push transition frames into GPU composition. With
+// ro.sf.screen_decor_mask set, mark SystemUI's screen decoration layer on the primary display.
+void markScreenDecorAsMask(const char* name, HWC2::Layer& hwcLayer) {
+    static const bool enabled = base::GetBoolProperty("ro.sf.screen_decor_mask", false);
+    if (!enabled || !name || !strstr(name, "ScreenDecorHwcOverlay")) return;
+
+    const sp<IBinder> binder = defaultServiceManager()->checkService(
+            String16("vendor.qti.hardware.display.config.IDisplayConfig/default"));
+    if (!binder) {
+        ALOGW("%s: no DisplayConfig service", __func__);
+        return;
+    }
+    // IDisplayConfig.setLayerAsMask(int dispId, long layerId) is its 28th method. Stable AIDL
+    // only appends methods, so the code is the same in every version that has it.
+    constexpr uint32_t kSetLayerAsMask = IBinder::FIRST_CALL_TRANSACTION + 27;
+    Parcel data, reply;
+    data.markForBinder(binder);
+    data.writeInterfaceToken(String16("vendor.qti.hardware.display.config.IDisplayConfig"));
+    data.writeInt32(0); // the primary built-in display
+    data.writeInt64(static_cast<int64_t>(hwcLayer.getId()));
+    status_t err = binder->transact(kSetLayerAsMask, data, &reply);
+    if (err == OK) err = reply.readExceptionCode();
+    ALOGI("%s: %s (HWC layer %" PRIu64 "): %d", __func__, name, hwcLayer.getId(), err);
+}
+
+} // namespace
+
 std::shared_ptr<Display> createDisplay(
         const compositionengine::CompositionEngine& compositionEngine,
         const compositionengine::DisplayCreationArgs& args) {
@@ -175,6 +211,10 @@ std::unique_ptr<compositionengine::OutputLayer> Display::createOutputLayer(
         auto hwcLayer = hwc.createLayer(*halDisplayId);
         ALOGE_IF(!hwcLayer, "Failed to create a HWC layer for a HWC supported display %s",
                  getName().c_str());
+        if (hwcLayer && !hwc.isHeadless() &&
+            halDisplayId->value == hwc.getPrimaryDisplayId().value) {
+            markScreenDecorAsMask(layerFE->getDebugName(), *hwcLayer);
+        }
         outputLayer->setHwcLayer(std::move(hwcLayer));
     }
     return outputLayer;
