From 08e86454da5b7395715e882bf38a6a9f79f25080 Mon Sep 17 00:00:00 2001
From: Alexander Gurov <aliogu23@gmail.com>
Date: Tue, 6 Oct 2026 15:11:52 +0300
Subject: [PATCH 3/3] CompositionEngine: Optionally boost the GPU for all
 client composition

ro.sf.gpu_composition_boost treats every client-composed frame as
expensive (EXPENSIVE_RENDERING, a GPU floor in the power HAL). On GPUs
whose governor sits at a mid clock during transitions (Adreno 710: 600
MHz while composition takes ~4 ms) the floor makes the deadlines.

A single frame without client composition inside a transition would
drop the boost while the rest of the animation still needs the GPU, so
keep it for 300 ms after the last client-composed frame; PowerAdvisor's
idle timer still turns it off once the screen stops.

Claude-Session: https://claude.ai/code/session_01HCu2kUrLkzjzZJEZ6mCKqM
---
 .../CompositionEngine/src/Output.cpp          | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/services/surfaceflinger/CompositionEngine/src/Output.cpp b/services/surfaceflinger/CompositionEngine/src/Output.cpp
index f69188b6ec..dc9a9951c4 100644
--- a/services/surfaceflinger/CompositionEngine/src/Output.cpp
+++ b/services/surfaceflinger/CompositionEngine/src/Output.cpp
@@ -56,6 +56,7 @@
 #pragma clang diagnostic pop // ignored "-Wconversion"
 
 #include <android-base/properties.h>
+#include <atomic>
 #include <gui/LayerState.h>
 #include <ui/DebugUtils.h>
 #include <ui/HdrCapabilities.h>
@@ -66,6 +67,21 @@ using aidl::android::hardware::graphics::composer3::Composition;
 
 namespace android::compositionengine {
 
+namespace {
+// ro.sf.gpu_composition_boost: treat every client-composed frame as expensive (EXPENSIVE_RENDERING,
+// a GPU floor in the power HAL). On GPUs whose governor sits at a mid clock during transitions
+// (Adreno 710: 600 MHz while composition takes ~4 ms) the floor makes the deadlines. One frame
+// without client composition inside a transition would drop it while the rest of the animation
+// still needs the GPU, so keep it for a short while; PowerAdvisor's idle timer (80 ms without
+// screen updates) still turns it off when the screen stops.
+bool boostAllClientComposition() {
+    static const bool sEnabled = base::GetBoolProperty("ro.sf.gpu_composition_boost", false);
+    return sEnabled;
+}
+std::atomic<nsecs_t> sLastClientCompositionTime{0};
+constexpr nsecs_t kClientCompositionBoostHoldNs = 300'000'000;
+} // namespace
+
 Output::~Output() = default;
 
 namespace impl {
@@ -1413,7 +1429,10 @@ std::optional<base::unique_fd> Output::composeSurfaces(
                      : "",
              outputState.usesClientComposition};
     if (!hasClientComposition) {
-        setExpensiveRenderingExpected(false);
+        if (!boostAllClientComposition() ||
+            systemTime() - sLastClientCompositionTime.load() > kClientCompositionBoostHoldNs) {
+            setExpensiveRenderingExpected(false);
+        }
         return base::unique_fd();
     }
 
@@ -1462,7 +1481,10 @@ std::optional<base::unique_fd> Output::composeSurfaces(
     // GPU composition can finish in time. We must reset GPU frequency afterwards,
     // because high frequency consumes extra battery.
     const bool expensiveBlurs = mLayerRequestingBackgroundBlur != nullptr;
-    const bool expensiveRenderingExpected = expensiveBlurs ||
+    if (boostAllClientComposition()) {
+        sLastClientCompositionTime.store(systemTime());
+    }
+    const bool expensiveRenderingExpected = expensiveBlurs || boostAllClientComposition() ||
             std::any_of(clientCompositionLayers.begin(), clientCompositionLayers.end(),
                         [outputDataspace =
                                  clientCompositionDisplay.outputDataspace](const auto& layer) {
