+     * SurfaceFlinger marks as masks (ro.sf.screen_decor_mask). Use the decoration layer then, as
+     * RGBA_8888 (see ScreenDecorHwcLayer's RcMaskSurface): the corners move out of the overlay
+     * windows, which keep only the privacy dots and show up only with them.
+     */
+    private DisplayDecorationSupport getDisplayDecorationSupport() {
+        DisplayDecorationSupport support = mContext.getDisplay().getDisplayDecorationSupport();
+        if (support == null && mContext.getDisplayId() == Display.DEFAULT_DISPLAY
+                && SystemProperties.getBoolean("ro.sf.screen_decor_mask", false)) {
+            support = new DisplayDecorationSupport();
+            support.format = PixelFormat.RGBA_8888;
+            support.alphaInterpretation = AlphaInterpretation.MASK;
+        }
+        return support;
+    }
