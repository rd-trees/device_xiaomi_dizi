+/**
+ * The screen decoration for Qualcomm's rounded-corner (RC) block: SurfaceFlinger marks this layer
+ * as a mask (ro.sf.screen_decor_mask), and SDM then draws the corners in the display engine instead
+ * of spending a source pipe on them. SDM takes only linear, untransformed masks: GPU-rendered
+ * buffers are compressed (UBWC), and a software-rendered window isn't pre-rotated. So draw on the
+ * CPU (linear) into a buffer in the panel's natural orientation, rotated like HWUI pre-rotation,
+ * and put the inverse in the buffer transform, on a child surface of the decoration window.
+ */
+private class RcMaskSurface {
+    private var surfaceControl: SurfaceControl? = null
+    private var parent: SurfaceControl? = null
+    private var reader: ImageReader? = null
+
+    fun post(view: View, draw: (Canvas) -> Unit) {
+        val parentSc = view.viewRootImpl?.surfaceControl ?: return
+        if (!parentSc.isValid || view.width == 0 || view.height == 0) return
+        val w = view.width
+        val h = view.height
+        val hint = parentSc.transformHint
+        val rotated = (hint and SurfaceControl.BUFFER_TRANSFORM_ROTATE_90) != 0
+        val bufferWidth = if (rotated) h else w
+        val bufferHeight = if (rotated) w else h
+
+        val r = reader?.takeIf { it.width == bufferWidth && it.height == bufferHeight }
+            ?: newReader(bufferWidth, bufferHeight)
+        val canvas = r.surface.lockCanvas(null)
+        try {
+            canvas.drawColor(Color.TRANSPARENT, PorterDuff.Mode.CLEAR)
+            // The same pre-rotation as HWUI's GetPreTransformMatrix for this hint.
+            when (hint) {
+                SurfaceControl.BUFFER_TRANSFORM_ROTATE_90 -> {
+                    canvas.translate(h.toFloat(), 0f)
+                    canvas.rotate(90f)
+                }
+                SurfaceControl.BUFFER_TRANSFORM_ROTATE_180 -> {
+                    canvas.translate(w.toFloat(), h.toFloat())
+                    canvas.rotate(180f)
+                }
+                SurfaceControl.BUFFER_TRANSFORM_ROTATE_270 -> {
+                    canvas.translate(0f, w.toFloat())
+                    canvas.rotate(270f)
+                }
+            }
+            draw(canvas)
+        } finally {
+            r.surface.unlockCanvasAndPost(canvas)
+        }
+        val image = r.acquireLatestImage() ?: return
+        val buffer = image.hardwareBuffer
+        if (buffer == null) {
+            image.close()
+            return
+        }
+
+        val t = SurfaceControl.Transaction()
+        val sc = surfaceControl ?: SurfaceControl.Builder()
+            .setName("ScreenDecorHwcOverlay RC mask")
+            .setParent(parentSc)
+            .setCallsite("ScreenDecorHwcLayer.RcMaskSurface")
+            .build()
+            .also { surfaceControl = it }
+        if (parent != parentSc) {
+            t.reparent(sc, parentSc)
+            parent = parentSc
+        }
+        t.setBuffer(sc, buffer, null) { image.close() }
+            .setBufferTransform(sc, invert(hint))
+            .setLayer(sc, 1)
+            .show(sc)
+            .apply()
+        buffer.close()
+    }
+
+    fun release() {
+        surfaceControl?.let { SurfaceControl.Transaction().remove(it).apply() }
+        surfaceControl = null
+        parent = null
+        reader?.close()
+        reader = null
+    }
+
+    private fun newReader(width: Int, height: Int): ImageReader {
+        reader?.close()
+        // CPU usage keeps gralloc from compressing it; GPU sampling lets SurfaceFlinger fall back
+        // to client composition if SDM declines the mask.
+        return ImageReader.newInstance(
+            width, height, PixelFormat.RGBA_8888, 3,
+            HardwareBuffer.USAGE_CPU_WRITE_OFTEN or HardwareBuffer.USAGE_CPU_READ_RARELY or
+                HardwareBuffer.USAGE_COMPOSER_OVERLAY or HardwareBuffer.USAGE_GPU_SAMPLED_IMAGE
+        ).also { reader = it }
+    }
+
+    private fun invert(transform: Int): Int = when (transform) {
+        SurfaceControl.BUFFER_TRANSFORM_ROTATE_90 -> SurfaceControl.BUFFER_TRANSFORM_ROTATE_270
+        SurfaceControl.BUFFER_TRANSFORM_ROTATE_270 -> SurfaceControl.BUFFER_TRANSFORM_ROTATE_90
+        else -> transform
+    }
+}
