ifneq ($(DIZI_ADB_KEYS),)
PRODUCT_ADB_KEYS := $(DIZI_ADB_KEYS)
endif
endif

# Bring-up: EvoX init forces ro.debuggable=0 / ro.adb.secure=1 for Play
