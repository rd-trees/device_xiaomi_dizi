on boot
    # Touchscreen / stylus (NT36532 + xiaomi_touch)
    chown system system /dev/xiaomi-touch
    chmod 0660 /dev/xiaomi-touch
    chown system system /dev/mipp_pen0
    chmod 0660 /dev/mipp_pen0
    chown system system /sys/class/touch/touch_dev/palm_sensor
    chmod 0664 /sys/class/touch/touch_dev/palm_sensor
    chown system system /sys/class/touch/touch_dev/pen_connect_strategy
    chmod 0664 /sys/class/touch/touch_dev/pen_connect_strategy

on property:sys.boot_completed=1
    write /sys/devices/virtual/thermal/thermal_message/sconfig 20

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

on property:vendor.post_boot.parsed=1
    # Set restricted cpuset to the same CPUs as system-background
    copy /dev/cpuset/system-background/cpus /dev/cpuset/restricted/cpus

    # Set background cpuset
    write /dev/cpuset/background/cpus 0-1

    # Setup foreground cpuset for display composer.
    write /dev/cpuset/foreground/cpus 0-6

    # WALT as stock's 120 Hz boost (perf hint 0x109B) leaves it: 8 ms window with predictive
    # load, render-thread group boosting and colocation (the min task utils are in
    # powerhint.json). Stock's floors (3 golds online, silver 806 MHz) gained nothing measurable
    # and stay out. Recents launcher jank ~2.6 -> ~2.1 % (cnb-release-4, portrait).
    write /proc/sys/walt/sched_ravg_window_nr_ticks 2
    write /sys/devices/system/cpu/cpufreq/policy0/walt/pl 1
    write /sys/devices/system/cpu/cpufreq/policy4/walt/pl 1
    write /proc/sys/walt/walt_rtg_cfs_boost_prio 119
    write /proc/sys/walt/sched_coloc_downmigrate_ns 100000000
    write /proc/sys/walt/walt_low_latency_task_threshold 100
    write /proc/sys/walt/sched_coloc_busy_hysteresis_enable_cpus 112

# The display composer runs HWC validate on SurfaceFlinger's critical path. Its stock rc puts it in
# system-background (CPUs 0-3), and the perf hint that would move it to the big cores during
# GPU-composed frames needs QTI perfd, which we don't ship. Put it in the foreground cpuset above.
service vendor.qti.hardware.display.composer /vendor/bin/hw/vendor.qti.hardware.display.composer-service
    override
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    onrestart restart feature_enabler_client
    socket pps stream 0660 system system
    task_profiles ProcessCapacityHigh

service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
    override
    class hal
    user audioserver
    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct oem_2901 wakelock context_hub
    capabilities BLOCK_SUSPEND SYS_NICE
    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    onrestart restart audioserver

# EvoX GameBar's init.gamebar.rc makes two thermal zones' temp nodes
# system:system 0660. The QTI thermal HAL runs as root in group root, and AOSP
# forbids a DAC-bypass capability for it, so give it the system group; without
# it the HAL reports no temperatures under enforcing (build-24).
service vendor.thermal-hal /vendor/bin/hw/android.hardware.thermal-service.qti
    override
    interface aidl android.hardware.thermal.IThermal/default
    class hal
    user root
    group root system

service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.xiaomi-multihal
    override
    class hal
    user system
    group system wakelock context_hub input uhid
    writepid /dev/cpuset/system-background/tasks
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10

# Redmi Smart Pen: DiziPen reports Bluetooth pen transitions via
# vendor.pen.state; xiaomi-pen forwards them to the touch IC. Reset the
# driver's connect counter on every boot so it cannot drift.
on boot
    exec_background u:r:xiaomi_pen:s0 system system -- /vendor/bin/xiaomi-pen reset

on property:vendor.pen.state=*
    exec_background u:r:xiaomi_pen:s0 system system -- /vendor/bin/xiaomi-pen ${vendor.pen.state}

# Recover USB (MTP, adb) when the controller misses the attach at boot; without it the
# cable has to be replugged after every boot.
service vendor.usb_attach /vendor/bin/init.dizi.usb_attach.sh
    class late_start
    user root
    group root
    oneshot
    disabled
    seclabel u:r:vendor_qti_init_shell:s0

# Start as soon as adbd runs, not at boot_completed: a boot that hangs
# earlier is exactly when USB adb is needed.
on property:init.svc.adbd=running && property:ro.debuggable=1
    start vendor.usb_attach

# All builds: user builds don't start adbd at boot, but MTP needs the attach too.
on property:sys.boot_completed=1
    start vendor.usb_attach

# zram: lz4 instead of the kernel default lzo-rle. It decompresses several times
# faster, so swapped-out apps come back sooner, for a slightly worse ratio. Pixel
# devices use it. Must be set before init.kernel.post_boot.sh sizes the device
# after boot completes; that script only picks lz4 for low_ram (Go) targets.
on boot
    write /sys/block/zram0/comp_algorithm lz4
