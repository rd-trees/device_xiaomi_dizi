# CNE
persist.vendor.cne.feature=1

# Device
ro.product.mod_device=dizi_global

# QTI
ro.vendor.qti.va_aosp.support=1

# Radio
DEVICE_PROVISIONED=1
persist.vendor.data.mode=concurrent
persist.vendor.vonr_setting_support=1
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33
telephony.lteOnCdmaDevice=1

# RIL Powersaving
persist.radio.add_power_save=1
pm.sleep_mode=1
ro.ril.disable.power.collapse=0
ro.ril.fast.dormancy.rule=1
ro.ril.fast.dormancy.timeout=3
ro.mot.eri.losalert.delay=100
ro.vendor.use_data_netmgrd=true
ro.vold.umsdirtyratio=20
power.saving.mode=1

# Device name, as stock
ro.product.marketname=Redmi Pad Pro

# Screen corners: SurfaceFlinger marks SystemUI's decoration layer as a mask for the display
# engine's rounded-corner block (SDM RC), so the corners take no source pipe (3 on SM7435).
ro.sf.screen_decor_mask=true

# GPU floor (EXPENSIVE_RENDERING, 940 MHz in powerhint.json) on every client-composed frame: the
# Adreno governor holds 600 MHz during transitions, where SF's GPU composition then misses deadlines.
ro.sf.gpu_composition_boost=true
